# Copia para .env.local e preenche com os valores do teu projeto Supabase
# (Painel Supabase › Project Settings › API Keys / botão «Connect»).
# Estas chaves são PÚBLICAS por natureza: a proteção dos dados é feita por RLS.
# NUNCA coloques aqui a chave secreta (sb_secret_…) nem a service_role.
VITE_SUPABASE_URL=https://o-teu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Rótulo opcional mostrado no topo para distinguir ambientes (ex.: "Demonstração").
# Deixa vazio em produção.
VITE_ENVIRONMENT_LABEL=
