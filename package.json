{
  "name": "pioneiros",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pioneiros — acompanhamento do progresso pessoal (III Secção, CNE). Ferramenta local; não substitui registos oficiais.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:db": "bash tests/db/reset.sh && vitest run --project db",
    "catalog:verify": "node scripts/verify-catalog.mjs",
    "catalog:sql": "node scripts/generate-catalog-sql.mjs",
    "test:e2e": "playwright test",
    "db:bundle": "node scripts/bundle-migrations.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.56.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
